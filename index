/* ---------- 9. VUE : WIZARD ---------- */
function viewWizard() {
  const p = state.currentProject;
  const section = SECTIONS[state.currentStep];
  const w = el('div');

  const header = el('div', { class: 'topbar' });
  header.innerHTML = `<div><h2>${section.icon} ${section.title}</h2>
    <div class="topbar-info">Étape ${state.currentStep + 1} sur ${SECTIONS.length} · ${esc(p.data.A?.projectName || 'Nouveau projet')}</div></div>
    <button class="btn" id="btn-back">← Tableau de bord</button>`;
  header.querySelector('#btn-back').onclick = () => navigate('dashboard');
  w.appendChild(header);

  const prog = el('div', { class: 'progress-steps' });
  SECTIONS.forEach((s, i) => {
    const cls = i === state.currentStep ? 'active' : (p.completedSteps?.includes(s.id) ? 'done' : '');
    prog.appendChild(el('div', { class: `step-pill ${cls}` }));
  });
  w.appendChild(prog);

  const card = el('div', { class: 'card' });

  if (section.financial === 'investments') card.appendChild(renderInvestForm());
  else if (section.financial === 'operating') card.appendChild(renderOperatingForm());
  else if (section.id === 'G') card.appendChild(renderGForm());
  else card.appendChild(renderGenericForm(section));

  const nav = el('div', { class: 'flex justify-between align-center mt-4' });
  const prev = el('button', { class: 'btn', id: 'btn-prev' }, '← Précédent');
  prev.disabled = state.currentStep === 0;
  prev.onclick = () => { state.currentStep--; render(); };
  const next = el('button', { class: 'btn btn-primary', id: 'btn-next' },
    state.currentStep === SECTIONS.length - 1 ? '✓ Terminer' : 'Suivant →');
  next.onclick = async () => {
    if (!p.completedSteps) p.completedSteps = [];
    if (!p.completedSteps.includes(section.id)) p.completedSteps.push(section.id);
    if (p.data.A?.projectName) p.name = p.data.A.projectName;
    await persist();
    if (state.currentStep === SECTIONS.length - 1) navigate('dashboard');
    else { state.currentStep++; render(); }
  };
  nav.appendChild(prev);
  nav.appendChild(next);
  card.appendChild(nav);
  w.appendChild(card);
  return w;
}

function renderGenericForm(section) {
  const wrap = el('div');
  const data = state.currentProject.data[section.id] || {};
  section.fields.forEach(f => {
    const g = el('div', { class: 'form-group' });
    g.innerHTML = `<label>${esc(f.label)} ${f.required ? '<span class="req">*</span>' : ''}</label>`;
    let input;
    if (f.type === 'textarea') {
      input = el('textarea', { rows: 3 });
    } else if (f.type === 'select') {
      input = el('select');
      input.appendChild(el('option', { value: '' }, '— Sélectionner —'));
      (f.options || []).forEach(o => {
        const opt = el('option', { value: o }, o);
        if (data[f.key] === o) opt.selected = true;
        input.appendChild(opt);
      });
    } else {
      input = el('input', { type: f.type || 'text', placeholder: f.placeholder || '' });
    }
    input.value = data[f.key] || '';
    input.onchange = async (e) => {
      if (!state.currentProject.data[section.id]) state.currentProject.data[section.id] = {};
      state.currentProject.data[section.id][f.key] = e.target.value;
      if (section.id === 'A' && f.key === 'projectName') state.currentProject.name = e.target.value;
      await persist();
    };
    g.appendChild(input);
    wrap.appendChild(g);
  });
  return wrap;
}

