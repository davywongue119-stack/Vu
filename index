              (gap > 0 ? `⚠️ Financement insuffisant de ${fmtMoney(gap)}` : `ℹ️ Excédent de financement de ${fmtMoney(-gap)}`);
  wrap.appendChild(el('div', { class: `alert ${cls}` }, `<b>${msg}</b>`));

  return wrap;
