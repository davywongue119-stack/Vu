      ['Poste', 'Montant (FCFA)'],
      ['Terrain', inv.terrain], ['Construction', inv.construction],
      ['Équipements', inv.equipment], ['Mobilier', inv.furniture],
      ['Informatique', inv.it], ['Véhicules', inv.vehicle],
      ['Frais de constitution', inv.fees], ['Frais de lancement', inv.launch],
      ['Fonds de roulement', inv.workingCapital],
      ['TOTAL', Object.values(inv).reduce((a, b) => a + (+b || 0), 0)]
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(invData), 'Investissements');

    const plData = [['Poste', 'An 1', 'An 2', 'An 3', 'An 4', 'An 5']];
    ['revenue', 'materials', 'margin', 'ebe', 'depreciation', 'interest', 'beforeTax', 'tax', 'netIncome'].forEach(k => {
      plData.push([k, ...r.pl.map(p => Math.round(p[k]))]);
    });
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(plData), 'Compte de résultat');

    const cfData = [['Année', 'Flux'], ...r.cashFlows.map((cf, i) => [i === 0 ? 'Init' : 'An ' + i, Math.round(cf)])];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(cfData), 'Cash-flow');

    const indData = [
      ['Indicateur', 'Valeur'],
      ['VAN', Math.round(r.npv)],
      ['TRI', isFinite(r.irr) ? (r.irr * 100).toFixed(2) + '%' : 'N/A'],
      ['Payback', r.payback ? r.payback + ' an(s)' : '> 5 ans'],
      ['Seuil de rentabilité', Math.round(r.breakEven)],
      ['BFR', Math.round(r.bfr)]
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(indData), 'Indicateurs');

    XLSX.writeFile(wb, sanitizeFilename(state.currentProject.data.A?.projectName || 'business-plan') + '-financier.xlsx');
  } catch (e) { alert('Erreur XLSX : ' + e.message); }
}

async function exportFullPDF() {
  try {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF();
    const p = state.currentProject;
    const d = p.data;

    // Couverture
    pdf.setFontSize(28);
    pdf.setTextColor(37, 99, 235);
    pdf.text('BUSINESS PLAN', 14, 40);
    pdf.setFontSize(20);
    pdf.setTextColor(30, 41, 59);
    pdf.text(d.A?.projectName || 'Projet', 14, 55);
    pdf.setFontSize(12);
    pdf.setTextColor(100, 116, 139);
    pdf.text('Promoteur : ' + (d.A?.promoter || '—'), 14, 70);
    pdf.text('Localisation : ' + (d.A?.location || '—'), 14, 78);
    pdf.text('Date : ' + new Date().toLocaleDateString('fr-FR'), 14, 86);

    // Sommaire
    pdf.addPage();
    pdf.setFontSize(18);
    pdf.setTextColor(30, 41, 59);
    pdf.text('Table des matières', 14, 20);
    pdf.setFontSize(11);
    const toc = [
      "1. Fiche d'identification", '2. Résumé exécutif', '3. Présentation du promoteur',
      "4. Présentation de l'entreprise", '5. Étude de marché', '6. Étude technique',
      '7. Étude financière', '8. Gestion des risques', '9. Planning de mise en œuvre'
    ];
    toc.forEach((t, i) => pdf.text(t, 14, 35 + i * 8));

    const allDocs = ['fiche', 'resume', 'promoteur', 'entreprise', 'marche', 'technique', 'financiere', 'risques', 'planning'];
    const titles = ["Fiche d'identification", 'Résumé exécutif', 'Présentation du promoteur', "Présentation de l'entreprise", 'Étude de marché', 'Étude technique', 'Étude financière', 'Gestion des risques', 'Planning de mise en œuvre'];
    allDocs.forEach((id, i) => {
      pdf.addPage();
      pdf.setFontSize(16);
      pdf.setTextColor(37, 99, 235);
      pdf.text(titles[i], 14, 20);
      pdf.setFontSize(10);
      pdf.setTextColor(30, 41, 59);
      const content = stripHtml(generateDocument(id));
      const lines = pdf.splitTextToSize(content, 180);
      let y = 32;
      lines.forEach(line => {
        if (y > 280) { pdf.addPage(); y = 20; }
        pdf.text(line, 14, y);
        y += 5;
      });
    });

    pdf.save(sanitizeFilename(d.A?.projectName || 'business-plan') + '-complet.pdf');
  } catch (e) { alert('Erreur PDF complet : ' + e.message); }
}

/* ---------- 15. VUE : PARAMÈTRES ---------- */
function viewSettings() {
  const w = el('div');
  const p = state.currentProject;
  w.appendChild(el('div', { class: 'topbar' }, `<h2>⚙️ Paramètres du projet</h2>`));

  const info = el('div', { class: 'card' });
  info.innerHTML = `
    <h3>Informations générales</h3>
    <div class="form-group">
      <label>Nom du projet</label>
      <input type="text" id="set-name" value="${esc(p.data.A?.projectName || '')}" />
    </div>
    <div class="form-group">
      <label>Pays d'implantation</label>
      <select id="set-country">
        ${['Cameroun', 'Gabon', 'Congo', 'Tchad', 'RCA', 'Guinée Équatoriale', 'Autre'].map(c => `<option ${p.data.meta?.country === c ? 'selected' : ''}>${c}</option>`).join('')}
      </select>
      <div class="hint">Paramètres par défaut : Cameroun (SYSCOHADA révisé, OHADA).</div>
    </div>
    <div class="form-group">
      <label>Scénario de simulation</label>
      <select id="set-scenario">
        ${['prudent', 'realistic', 'optimistic'].map(s => `<option value="${s}" ${p.data.scenario === s ? 'selected' : ''}>${{ prudent: 'Prudent', realistic: 'Réaliste', optimistic: 'Optimiste' }[s]}</option>`).join('')}
      </select>
    </div>`;
  w.appendChild(info);

  info.querySelector('#set-name').onchange = async (e) => {
    if (!p.data.A) p.data.A = {};
    p.data.A.projectName = e.target.value;
    p.name = e.target.value;
    await persist();
  };
  info.querySelector('#set-country').onchange = async (e) => {
    if (!p.data.meta) p.data.meta = {};
    p.data.meta.country = e.target.value;
    await persist();
  };
  info.querySelector('#set-scenario').onchange = async (e) => {
    p.data.scenario = e.target.value;
    await persist(); render();
  };

  const danger = el('div', { class: 'card' });
  danger.innerHTML = `
    <h3>Zone dangereuse</h3>
    <p style="color:var(--text-light);font-size:13px;margin-bottom:12px;">Supprimer ce projet effacera définitivement toutes les données associées.</p>
    <button class="btn btn-danger" id="btn-delete">Supprimer ce projet</button>`;
  danger.querySelector('#btn-delete').onclick = () => confirmDelete(p.id);
  w.appendChild(danger);

  const exportAll = el('div', { class: 'card' });
  exportAll.innerHTML = `
    <h3>Exports</h3>
    <div class="btn-group">
      <button class="btn" id="exp-json">📦 Exporter données (JSON)</button>
      <button class="btn btn-primary" id="exp-pdf">📄 Business plan complet (PDF)</button>
      <button class="btn btn-success" id="exp-xlsx">📊 Tableaux financiers (XLSX)</button>
    </div>`;
  exportAll.querySelector('#exp-json').onclick = () => {
    const blob = new Blob([JSON.stringify(p, null, 2)], { type: 'application/json' });
    saveAs(blob, sanitizeFilename(p.name) + '.json');
  };
  exportAll.querySelector('#exp-pdf').onclick = exportFullPDF;
  exportAll.querySelector('#exp-xlsx').onclick = exportFinancialsXLSX;
  w.appendChild(exportAll);

  return w;
}

