function renderPositionsTable(container, positions) {
  container.innerHTML = '';
  const p = state.currentProject;
  if (!positions.length) {
    container.innerHTML = '<div class="hint">Aucun poste renseigné.</div>';
    return;
  }
  const table = el('table');
  table.innerHTML = `<thead><tr><th>Intitulé</th><th>Nombre</th><th>Salaire mensuel (FCFA)</th><th></th></tr></thead>`;
  const tb = el('tbody');
  positions.forEach((pos, i) => {
    const tr = el('tr');
    ['title', 'count', 'salary'].forEach(k => {
      const td = el('td');
      const inp = el('input', { type: k === 'title' ? 'text' : 'number', min: 0 });
      inp.value = pos[k] || (k === 'count' ? 1 : '');
      inp.style.padding = '4px';
      inp.onchange = async (e) => {
        p.data.positions[i][k] = k === 'title' ? e.target.value : +e.target.value;
