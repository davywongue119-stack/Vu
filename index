function renderInvestTable(inv) {
  const rows = [
    ['Terrain et aménagements', inv.terrain],
    ['Construction / rénovation', inv.construction],
    ['Équipements et matériels', inv.equipment],
    ['Mobilier', inv.furniture],
    ['Matériel informatique', inv.it],
    ['Véhicules', inv.vehicle],
    ['Frais de constitution', inv.fees],
    ['Frais de lancement', inv.launch],
    ['Fonds de roulement', inv.workingCapital]
  ];
  const total = rows.reduce((a, [, v]) => a + (+v || 0), 0);
  return `<table><thead><tr><th>Poste</th><th class="num">Montant</th></tr></thead><tbody>
    ${rows.map(([l, v]) => `<tr><td>${l}</td><td class="num">${fmtMoney(v)}</td></tr>`).join('')}
    <tr class="total"><td>TOTAL</td><td class="num">${fmtMoney(total)}</td></tr>
  </tbody></table>`;
}
function renderDepreciationTable(r) {
  return `<table><thead><tr><th>Année</th>${r.depreciation.map((_, i) => `<th class="num">An ${i + 1}</th>`).join('')}</tr></thead>
    <tbody><tr><td>Dotation aux amortissements</td>${r.depreciation.map(d => `<td class="num">${fmtMoney(d)}</td>`).join('')}</tr></tbody></table>`;
}
function renderFinancingTable(r) {
  return `<table><thead><tr><th>Source</th><th class="num">Montant</th><th class="num">%</th></tr></thead><tbody>
    <tr><td>Apport personnel</td><td class="num">${fmtMoney(r.equity)}</td><td class="num">${r.finTotal ? fmtPct(r.equity / r.finTotal) : '—'}</td></tr>
    <tr><td>Prêt bancaire</td><td class="num">${fmtMoney(r.loan)}</td><td class="num">${r.finTotal ? fmtPct(r.loan / r.finTotal) : '—'}</td></tr>
    <tr><td>Autres sources</td><td class="num">${fmtMoney(r.other)}</td><td class="num">${r.finTotal ? fmtPct(r.other / r.finTotal) : '—'}</td></tr>
    <tr class="total"><td>Total financement</td><td class="num">${fmtMoney(r.finTotal)}</td><td class="num">100%</td></tr>
    <tr><td>Investissement total</td><td class="num">${fmtMoney(r.invTotal)}</td><td></td></tr>
    <tr><td>Solde</td><td class="num"><span class="badge ${Math.abs(r.financingGap) < 1 ? 'success' : 'danger'}">${fmtMoney(r.financingGap)}</span></td><td></td></tr>
  </tbody></table>`;
}
function renderLoanTable(r) {
  return `<table><thead><tr><th>Année</th><th class="num">Mensualité</th><th class="num">Intérêts</th><th class="num">Capital</th><th class="num">Solde</th></tr></thead><tbody>
    ${r.amortization.map(a => `<tr><td>${a.year}</td><td class="num">${fmtMoney(a.payment)}</td><td class="num">${fmtMoney(a.interest)}</td><td class="num">${fmtMoney(a.principal)}</td><td class="num">${fmtMoney(a.balance)}</td></tr>`).join('')}
  </tbody></table>`;
}
function renderPLTable(r) {
  const lines = [
    ["Chiffre d'affaires", 'revenue'],
    ['Coût des matières', 'materials'],
    ['Marge brute', 'margin'],
    ['Charges salariales', 'salaries'],
    ['Loyers', 'rent'],
    ['Eau et électricité', 'utilities'],
    ['Transport', 'transport'],
    ['Marketing', 'marketing'],
    ['Impôts et taxes', 'taxes'],
    ['EBE (excédent brut)', 'ebe'],
    ['Amortissements', 'depreciation'],
    ['Charges financières', 'interest'],
    ['Résultat avant impôt', 'beforeTax'],
    ['Impôt sur les sociétés', 'tax'],
    ['RÉSULTAT NET', 'netIncome']
  ];
  return `<table><thead><tr><th>Poste</th>${r.pl.map(p => `<th class="num">An ${p.year}</th>`).join('')}</tr></thead><tbody>
    ${lines.map(([label, key]) => `<tr class="${key === 'netIncome' ? 'total' : ''}"><td>${label}</td>${r.pl.map(p => `<td class="num">${fmtMoney(p[key])}</td>`).join('')}</tr>`).join('')}
  </tbody></table>`;
}
function renderCashFlowTable(r) {
  let cumul = 0;
  const rows = r.cashFlows.map((cf, i) => {
    cumul += cf;
    return `<tr><td>${i === 0 ? 'Initial' : 'An ' + i}</td><td class="num">${fmtMoney(cf)}</td><td class="num">${fmtMoney(cumul)}</td></tr>`;
  }).join('');
  return `<table><thead><tr><th>Année</th><th class="num">Flux</th><th class="num">Cumulé</th></tr></thead><tbody>${rows}</tbody></table>`;
}

function renderFinancialsCharts() {
  const canvas = document.getElementById('chart-cf');
  if (!canvas) return;
  const r = Finance.compute(state.currentProject.data);
  let cumul = 0;
  const cumulData = r.cashFlows.map(cf => (cumul += cf, cumul));
  new Chart(canvas, {
    type: 'line',
    data: {
      labels: r.cashFlows.map((_, i) => i === 0 ? 'Init' : 'An ' + i),
      datasets: [
        { label: 'Flux de trésorerie', data: r.cashFlows, borderColor: '#2563eb', fill: false },
        { label: 'Cumulé', data: cumulData, borderColor: '#10b981', fill: false }
      ]
    },
    options: { responsive: true, maintainAspectRatio: false }
  });
}

