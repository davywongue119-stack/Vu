  w.appendChild(top);

  if (!state.projects.length) {
    const empty = el('div', { class: 'card empty-state' });
    empty.innerHTML = `<h3>Aucun projet pour l'instant</h3>
      <p>Créez votre premier business plan en quelques minutes.</p>
      <button class="btn btn-primary mt-4" id="btn-new2">+ Créer un projet</button>`;
    empty.querySelector('#btn-new2').onclick = newProject;
    w.appendChild(empty);
    return w;
  }

  const grid = el('div', { class: 'card-grid' });
  state.projects.sort((a, b) => b.updatedAt - a.updatedAt).forEach(p => {
    const d = p.data || {};
