  wrap.appendChild(el('h3', { class: 'mt-4' }, 'Financement'));
  [['equity', 'Apport personnel (FCFA)'], ['loan', 'Prêt bancaire (FCFA)'], ['other', 'Autres sources (FCFA)']].forEach(([k, l]) => {
    const g = el('div', { class: 'form-group' });
    g.innerHTML = `<label>${l}</label>`;
    const inp = el('input', { type: 'number', min: 0, step: 1000 });
    inp.value = fin[k] || 0;
    inp.onchange = async (e) => { state.currentProject.data.financing[k] = +e.target.value || 0; await persist(); render(); };
    g.appendChild(inp);
    wrap.appendChild(g);
  });

  const row = el('div', { class: 'form-row' });
  [['loanRate', 'Taux du prêt (ex: 0.12)', 0.01], ['loanDuration', 'Durée du prêt (années)', 1]].forEach(([k, l, step]) => {
    const g = el('div', { class: 'form-group' });
    g.innerHTML = `<label>${l}</label>`;
    const inp = el('input', { type: 'number', step: step, min: 0 });
