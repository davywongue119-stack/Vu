};

const $ = (sel) => document.querySelector(sel);
function el(tag, attrs = {}, html = '') {
  const e = document.createElement(tag);
  Object.entries(attrs).forEach(([k, v]) => {
    if (k === 'class') e.className = v;
    else if (k === 'onclick') e.onclick = v;
    else if (k.startsWith('data-')) e.setAttribute(k, v);
    else e[k] = v;
  });
  if (html) e.innerHTML = html;
  return e;
}
const uid = () => 'p_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
const fmtMoney = (n) => (Math.round(+n || 0)).toLocaleString('fr-FR') + ' FCFA';
const fmtPct = (n) => ((+n || 0) * 100).toFixed(1) + '%';
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

/* ---------- 5. INIT ---------- */
async function init() {
  try {
    state.projects = await getAllProjects();
  } catch (e) {
    console.error('IndexedDB error:', e);
    state.projects = [];
  }
  render();
}

async function persist() {
  if (!state.currentProject) return;
  state.currentProject.updatedAt = Date.now();
  try {
    await saveProject(state.currentProject);
    state.projects = await getAllProjects();
  } catch (e) { console.error('Save error:', e); }
}

function navigate(view) {
  state.view = view;
  window.scrollTo(0, 0);
  render();
}

/* ---------- 6. ACTIONS ---------- */
async function newProject() {
  const p = {
    id: uid(),
    createdAt: Date.now(),
    updatedAt: Date.now(),
    name: 'Nouveau projet',
    data: JSON.parse(JSON.stringify(DEFAULT_DATA)),
    completedSteps: []
  };
  await saveProject(p);
  state.currentProject = p;
  state.currentStep = 0;
  state.projects = await getAllProjects();
  navigate('wizard');
}

async function openProject(id) {
  const p = await getProject(id);
  if (!p) return;
  state.currentProject = p;
  navigate('dashboard');
}

async function confirmDelete(id) {
  if (!confirm('Supprimer définitivement ce projet ?')) return;
  await deleteProject(id);
  state.projects = await getAllProjects();
  if (state.currentProject?.id === id) {
    state.currentProject = null;
    navigate('home');
  } else render();
}

/* ---------- 7. RENDER PRINCIPAL ---------- */
function render() {
  const app = $('#app');
  if (!state.currentProject && state.view !== 'home') state.view = 'home';
  app.innerHTML = '';
  const layout = el('div', { class: 'layout' });
  layout.appendChild(renderSidebar());
  const main = el('div', { class: 'main' });
  main.appendChild(renderView());
  layout.appendChild(main);
  app.appendChild(layout);

  if (state.view === 'dashboard') requestAnimationFrame(renderDashboardCharts);
  if (state.view === 'financials') requestAnimationFrame(renderFinancialsCharts);
}

function renderSidebar() {
  const sb = el('aside', { class: 'sidebar' });
  sb.appendChild(el('div', { class: 'sidebar-logo' },
    `<h1>Business<span>Plan</span> Pro</h1><small>Générateur de business plan</small>`));
  const nav = el('nav', { class: 'sidebar-nav' });
  const items = [
    { view: 'home', label: '🏠 Accueil', need: false },
    { view: 'dashboard', label: '📊 Tableau de bord', need: true },
    { view: 'wizard', label: '📝 Questionnaire', need: true },
    { view: 'financials', label: '💹 Analyse financière', need: true },
    { view: 'documents', label: '📚 Bibliothèque', need: true },
    { view: 'settings', label: '⚙️ Paramètres', need: true }
  ];
  items.forEach(it => {
    const disabled = it.need && !state.currentProject;
    const active = state.view === it.view ? 'active' : '';
    const n = el('div', {
      class: `nav-item ${active} ${disabled ? 'disabled' : ''}`,
      onclick: () => { if (!disabled) navigate(it.view); }
    }, `<span>${it.label}</span>`);
    nav.appendChild(n);
  });
  sb.appendChild(nav);
  return sb;
}

function renderView() {
  switch (state.view) {
    case 'home': return viewHome();
    case 'wizard': return viewWizard();
    case 'dashboard': return viewDashboard();
    case 'financials': return viewFinancials();
    case 'documents': return viewDocuments();
    case 'settings': return viewSettings();
    default: return viewHome();
  }
}

/* ---------- 8. VUE : ACCUEIL ---------- */
function viewHome() {
  const w = el('div');
  const top = el('div', { class: 'topbar' });
