<script>
/* =========================================================
   BusinessPlan Pro — Application monopage
   ========================================================= */

/* ---------- 1. PERSISTANCE INDEXEDDB ---------- */
const DB_NAME = 'BusinessPlanPro';
const DB_VERSION = 1;
const STORE = 'projects';
let _dbPromise;

function openDB() {
  if (_dbPromise) return _dbPromise;
  _dbPromise = new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = (e) => {
      const db = e.target.result;
      if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE, { keyPath: 'id' });
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
  return _dbPromise;
}
async function saveProject(project) {
  const db = await openDB();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(STORE, 'readwrite');
    tx.objectStore(STORE).put(project);
    tx.oncomplete = () => resolve(project);
    tx.onerror = () => reject(tx.error);
  });
}
async function getProject(id) {
  const db = await openDB();
  return new Promise((resolve, reject) => {
    const req = db.transaction(STORE, 'readonly').objectStore(STORE).get(id);
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}
async function getAllProjects() {
  const db = await openDB();
  return new Promise((resolve, reject) => {
    const req = db.transaction(STORE, 'readonly').objectStore(STORE).getAll();
    req.onsuccess = () => resolve(req.result || []);
    req.onerror = () => reject(req.error);
  });
}
async function deleteProject(id) {
  const db = await openDB();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(STORE, 'readwrite');
    tx.objectStore(STORE).delete(id);
    tx.oncomplete = () => resolve();
    tx.onerror = () => reject(tx.error);
  });
}

/* ---------- 2. MOTEUR DE CALCUL FINANCIER ---------- */
const Finance = {
  params: {
    taxRate: 0.33,
    vatRate: 0.1925,
    discountRate: 0.15,
    loanRate: 0.12,
    loanDuration: 5,
    deprecRates: { construction: 0.05, equipment: 0.20, furniture: 0.10, it: 0.333, vehicle: 0.20 }
  },
  amortize(principal, rate, years) {
    if (!principal || !years || principal <= 0) return [];
    const schedule = [];
    if (rate === 0) {
      const annual = principal / years;
      for (let y = 1; y <= years; y++) {
        schedule.push({ year: y, payment: annual, interest: 0, principal: annual, balance: Math.max(0, principal - annual * y) });
      }
      return schedule;
    }
    const annual = principal * rate / (1 - Math.pow(1 + rate, -years));
    let balance = principal;
    for (let y = 1; y <= years; y++) {
      const interest = balance * rate;
      const p = annual - interest;
      balance -= p;
      schedule.push({ year: y, payment: annual, interest, principal: p, balance: Math.max(0, balance) });
    }
    return schedule;
  },
  irr(cfs) {
    let guess = 0.1;
    for (let i = 0; i < 100; i++) {
      const npv = cfs.reduce((a, cf, t) => a + cf / Math.pow(1 + guess, t), 0);
      const dnpv = cfs.reduce((a, cf, t) => a - t * cf / Math.pow(1 + guess, t + 1), 0);
      if (Math.abs(npv) < 1) return guess;
      if (dnpv === 0) break;
      const next = guess - npv / dnpv;
      if (!isFinite(next) || next <= -0.99) return NaN;
      guess = next;
    }
    return isNaN(guess) ? NaN : guess;
  },
  compute(data) {
    const { investments: inv = {}, financing: fin = {}, revenue: rev = {}, operating: op = {}, fiscal: fis = {}, scenario = 'realistic' } = data;
    const scenarioMult = { prudent: 0.7, realistic: 1.0, optimistic: 1.3 }[scenario] ?? 1.0;

    const invTotal = Object.values(inv).reduce((a, b) => a + (+b || 0), 0);

    const depreciation = [];
    for (let y = 0; y < 5; y++) {
      let d = 0;
      for (const [k, rate] of Object.entries(this.params.deprecRates)) {
        const base = +inv[k] || 0;
        const duration = rate > 0 ? Math.ceil(1 / rate) : 0;
        if (duration > 0 && y < duration) d += base * rate;
      }
      if (y === 0) d += (+inv.fees || 0) + (+inv.launch || 0);
      depreciation.push(d);
    }

    const equity = +fin.equity || 0;
    const loan = +fin.loan || 0;
    const other = +fin.other || 0;
    const finTotal = equity + loan + other;
    const financingGap = invTotal - finTotal;

    const loanRate = fin.loanRate ?? this.params.loanRate;
    const loanDuration = fin.loanDuration ?? this.params.loanDuration;
    const amortization = this.amortize(loan, loanRate, loanDuration);

    const baseRev = (+rev.year1 || 0) * scenarioMult;
    const growth = +rev.growth || 0;
    const revenues = [];
    for (let y = 0; y < 5; y++) revenues.push(baseRev * Math.pow(1 + growth, y));

    const matPct = +op.materialPct ?? 0.35;
    const salaries = (+op.salaries || 0) * 12;
    const rent = (+op.rent || 0) * 12;
    const utilities = (+op.utilities || 0) * 12;
    const transport = (+op.transport || 0) * 12;
    const marketing = (+op.marketing || 0) * 12;
    const taxes = +op.taxes || 0;
    const fixedCosts = salaries + rent + utilities + transport + marketing + taxes;

    const pl = [];
    for (let y = 0; y < 5; y++) {
      const ca = revenues[y];
      const mat = ca * matPct;
      const margin = ca - mat;
      const ebe = margin - fixedCosts;
      const deprec = depreciation[y] || 0;
      const interest = amortization[y]?.interest || 0;
      const beforeTax = ebe - deprec - interest;
      const taxRate = +fis.taxRate ?? this.params.taxRate;
      const tax = beforeTax > 0 ? beforeTax * taxRate : 0;
      pl.push({
        year: y + 1, revenue: ca, materials: mat, margin, salaries, rent, utilities,
        transport, marketing, taxes, ebe, depreciation: deprec, interest,
        beforeTax, tax, netIncome: beforeTax - tax
      });
    }

    const cashFlows = pl.map(p => p.netIncome + p.depreciation);
    const allCfs = [-invTotal, ...cashFlows];

    const discountRate = +fis.discountRate ?? this.params.discountRate;
    const npv = allCfs.reduce((a, cf, t) => a + cf / Math.pow(1 + discountRate, t), 0);
    const irr = this.irr(allCfs);

    let cumul = 0, payback = null;
    for (let i = 0; i < allCfs.length; i++) {
      cumul += allCfs[i];
      if (i > 0 && cumul >= 0) { payback = i; break; }
    }

    const contributionMargin = 1 - matPct;
    const breakEven = contributionMargin > 0 ? (fixedCosts + (depreciation[0] || 0) + (amortization[0]?.interest || 0)) / contributionMargin : 0;
    const breakEvenDay = revenues[0] > 0 ? Math.round(breakEven / revenues[0] * 365) : 0;

    const bfr = revenues[0] * (30 / 365);

    const monthlyCash = [];
    for (let m = 0; m < 12; m++) {
      const monthlyRev = revenues[0] / 12;
      const monthlyExp = (revenues[0] * matPct + fixedCosts + (amortization[0]?.payment || 0)) / 12;
      monthlyCash.push(monthlyRev - monthlyExp);
    }

    return {
      invTotal, finTotal, financingGap, depreciation, amortization,
      revenues, pl, cashFlows: allCfs, npv, irr, payback,
      breakEven, breakEvenDay, bfr, monthlyCash,
      equity, loan, other, scenario, scenarioMult,
      warning: financingGap > 1 ? 'Plan de financement déséquilibré : financement insuffisant.' : null
    };
  }
};

/* ---------- 3. SCHÉMA DU QUESTIONNAIRE ---------- */
